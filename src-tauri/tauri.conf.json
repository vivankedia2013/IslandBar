{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IslandBar",
  "version": "1.0.0",
  "identifier": "app.islandbar.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "IslandBar",
        "width": 190,
        "height": 38,
        "center": true,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A dynamic island for your desktop",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "longDescription": "IslandBar adds an iPhone-style dynamic island to the top of your screen with now-playing music, a focus timer, weather, volume, Claude chat and a system monitor.",
    "publisher": "vivankedia2013"
  }
}